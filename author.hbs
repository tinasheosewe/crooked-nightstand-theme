{{!< default}}

<section class="archive-header">
    {{#author}}
    <span class="archive-kicker">Writer</span>
    <h1 class="archive-title">{{name}}</h1>
    {{#if bio}}<p class="archive-desc">{{bio}}</p>{{/if}}
    {{/author}}
</section>

<section class="story-index">
    <div class="story-list">
        {{#foreach posts}}
            {{> "story-card"}}
        {{/foreach}}
    </div>
</section>

{{pagination}}
