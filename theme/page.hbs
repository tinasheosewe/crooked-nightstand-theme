{{!< default}}

{{#post}}
<article class="post page">
    {{#if @page.show_title_and_feature_image}}
    <header class="post-header">
        <h1 class="post-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-dek">{{custom_excerpt}}</p>{{/if}}
    </header>

    {{#if feature_image}}
    <figure class="post-figure">
        <img src="{{img_url feature_image size="l"}}"
             srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
             sizes="(max-width: 1200px) 100vw, 1200px"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    </figure>
    {{/if}}
    {{/if}}

    <div class="gh-content gh-canvas">
        {{content}}
    </div>
</article>
{{/post}}
