{{!< default}}

{{#post}}
<article class="post">

    <header class="post-header">
        <div class="post-kicker">{{#primary_tag}}{{name}}{{else}}Fiction{{/primary_tag}}</div>
        <h1 class="post-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-dek">{{custom_excerpt}}</p>{{/if}}
        <div class="post-meta">
            {{#primary_author}}<span class="by">{{name}}</span>{{/primary_author}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
            <span class="rt">{{reading_time}}</span>
        </div>
    </header>

    {{#if feature_image}}
    <figure class="post-figure">
        <img src="{{img_url feature_image size="l"}}"
             srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
             sizes="(max-width: 1200px) 100vw, 1200px"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="gh-content gh-canvas">
        {{content}}
    </div>

    <footer class="post-footer">
        <div class="post-end" aria-hidden="true"></div>
        {{#if tags}}
        <div class="post-tags">
            {{#foreach tags}}<a class="pill" href="{{url}}">{{name}}</a>{{/foreach}}
        </div>
        {{/if}}
    </footer>

</article>

<nav class="post-nav" aria-label="More stories">
    <div class="post-nav-cell">
        {{#prev_post}}
        <a class="post-nav-link" href="{{url}}">
            <span class="post-nav-label">Previous</span>
            <span class="post-nav-title">{{title}}</span>
        </a>
        {{/prev_post}}
    </div>
    <div class="post-nav-cell post-nav-cell--right">
        {{#next_post}}
        <a class="post-nav-link" href="{{url}}">
            <span class="post-nav-label">Next</span>
            <span class="post-nav-title">{{title}}</span>
        </a>
        {{/next_post}}
    </div>
</nav>

{{#if @site.members_enabled}}
    {{#unless @member}}
    <aside class="subscribe-cta">
        <h2 class="subscribe-cta-title">Enjoyed this story?</h2>
        <p class="subscribe-cta-text">Subscribe to receive new stories as they are published — nothing else.</p>
        <a class="subscribe-cta-button" href="#/portal/signup" data-portal="signup">Subscribe</a>
    </aside>
    {{/unless}}
{{/if}}
{{/post}}
